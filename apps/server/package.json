{
  "name": "@recurron/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/index.test.ts",
    "test:auth": "tsx --test src/authorization.test.ts",
    "test:catalog": "tsx --env-file-if-exists=../../packages/db/.env --env-file-if-exists=.dev.vars --test src/catalog.test.ts",
    "test:catalog:unit": "tsx --test src/catalog-validation.test.ts"
  },
  "dependencies": {
    "@orpc/server": "catalog:",
    "@recurron/api": "workspace:*",
    "@recurron/db": "workspace:*",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@recurron/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}

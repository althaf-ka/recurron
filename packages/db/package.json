{
  "name": "@recurron/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx --env-file-if-exists=.env src/check.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@recurron/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

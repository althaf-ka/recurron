{
  "name": "recurron",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "@biomejs/biome": "catalog:"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "preview": "pnpm --filter @recurron/web preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm --filter @recurron/server test",
    "db:generate": "pnpm --filter @recurron/db db:generate",
    "db:migrate": "pnpm --filter @recurron/db db:migrate",
    "db:check": "pnpm --filter @recurron/db db:check"
  }
}

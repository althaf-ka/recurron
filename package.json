{
  "name": "recurron",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "preview": "pnpm --filter @recurron/web preview",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write",
    "test": "pnpm --filter @recurron/server test",
    "db:generate": "pnpm --filter @recurron/db db:generate",
    "db:migrate": "pnpm --filter @recurron/db db:migrate",
    "db:check": "pnpm --filter @recurron/db db:check",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "format:check": "oxfmt --check",
    "build:worker": "turbo run build --filter=@recurron/server"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "catalog:",
    "ultracite": "8.1.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "pnpm@11.24.0"
}
